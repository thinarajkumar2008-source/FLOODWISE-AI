# FLOODWISE AI Backend Environment Configuration
ENVIRONMENT=development
API_PREFIX=/api
DATABASE_URL=sqlite:///./floodwise.db
# For production PostgreSQL / PostGIS:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/floodwise_db
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
HEC_RAS_EXECUTABLE_PATH=
ENABLE_MOCK_HYDRO_ENGINE=true
DEMO_DATA_PATH=../data/demo/narmada_tawa_demo.geojson
